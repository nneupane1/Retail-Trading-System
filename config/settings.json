{
  "app": {
    "default_symbol": "BTCUSDT",
    "debug": true
  },
  "account": {
    "initial_equity": 20000,
    "risk_per_trade": 0.01,
    "risk_per_trade_by_side": {
      "short": 0.006
    }
  },
  "backtest": {
    "output_dir": "backtest/output",
    "opportunity_log_enabled": true,
    "opportunity_log_filename": "opportunities.csv",
    "calibration_output_dir": "backtest/output/calibration",
    "checkpoint_dir": "_checkpoints",
    "checkpoint_suffix": ".checkpoint.json",
    "resume_enabled": true,
    "save_every_steps": 250
  },
  "binance": {
    "base_url": "https://api.binance.com",
    "klines_path": "/api/v3/klines",
    "default_interval": "1m",
    "historical_limit": 1000,
    "recent_limit": 1000,
    "request_timeout_seconds": 20,
    "retry_attempts": 3,
    "retry_backoff_seconds": 1,
    "retry_status_codes": [418, 429, 500, 502, 503, 504],
    "retry_logging_enabled": true,
    "ssl_verify": false,
    "ca_bundle_path": null,
    "closed_klines_only": true,
    "throttle_seconds": 0.2
  },
  "downloads": {
    "history": {
      "checkpoint_dir": "_checkpoints",
      "checkpoint_suffix": ".checkpoint.json",
      "partial_suffix": ".partial.csv",
      "resume_enabled": true,
      "save_every_batches": 1,
      "status_every_batches": 1,
      "cleanup_partial_on_complete": true
    }
  },
  "entry": {
    "score_threshold": 4,
    "block_compression": false,
    "block_compression_sides": ["long"],
    "blocked_scores": [],
    "min_body_strength_by_score": {
      "8": 2.0
    },
    "blocked_upper_wick_ranges_by_score": {
      "8": [
        {
          "min": 0.1,
          "max": 0.3
        }
      ]
    },
    "blocked_lower_wick_ranges_by_score": {},
    "conditional_filters_by_score": {}
  },
  "features": {
    "ema_periods": {
      "fast": 20,
      "slow": 50
    },
    "structure": {
      "high_period": 20,
      "low_period": 10
    },
    "compression": {
      "fast_range_period": 10,
      "slow_range_period": 30,
      "ratio": 0.7
    },
    "pressure": {
      "atr_baseline_period": 20,
      "cluster_lookback": 12,
      "failed_event_lookback": 12,
      "rejection_tolerance_atr": 0.35,
      "high_rejection_close_position_max": 0.45,
      "low_rejection_close_position_min": 0.55,
      "near_level_atr_multiple": 0.25,
      "ignition_body_strength_min": 1.8,
      "ignition_close_position_min": 0.75,
      "ignition_close_position_max": 0.25,
      "atr_compression_ratio_max": 0.85,
      "range_compression_ratio_max": 0.72
    },
    "candle_metrics": {
      "average_body_period": 10
    },
    "indicators": {
      "atr_period": 14,
      "macd_fast_period": 12,
      "macd_slow_period": 26,
      "macd_signal_period": 9,
      "bollinger_period": 20,
      "bollinger_std_dev": 2.0
    }
  },
  "history": {
    "start_date": "2018-01-01",
    "end_date": "2026-05-22"
  },
  "live_sim": {
    "output_dir": "live_sim/output",
    "poll_seconds": 30
  },
  "position": {
    "min_stop_distance_ratio": 0.001,
    "min_stop_distance_absolute": 0.0,
    "max_position_size_units": null,
    "max_notional_equity_multiple": null
  },
  "storage": {
    "base_path": "data_storage"
  },
  "strategy": {
    "directional": {
      "enabled_sides": ["long", "short"]
    },
    "edge_selection": {
      "enabled": false,
      "table_path": "backtest/output/edge_lab/edge_table.json",
      "strong_body_threshold": 1.3,
      "vwap_far_threshold": 0.01,
      "min_expected_return": 0.0,
      "risk_mode": "blend",
      "default_risk_mult": 1.0,
      "max_risk_mult": 1.5
    },
    "edge_profiles": {
      "impulse_breakout": {
        "max_hold_candles": 6,
        "disable_pyramiding": true,
        "disable_trailing": true,
        "profit_lock_trigger_r": 1.5,
        "profit_lock_stop_r": 0.25
      }
    },
    "execution": {
      "mode": "weighted",
      "weighted": {
        "score_weight": 0.7,
        "momentum_weight": 0.3,
        "noise_guard_min_strength": 0.28,
        "min_entry_risk_multiplier": 0.28,
        "max_strength_multiplier": 1.6,
        "event_bonus": 1.12,
        "non_event_bonus": 1.0,
        "structural_floor_enabled": true,
        "structural_floor_anchor_column": "ema50",
        "bias_weights": {
          "bullish": 1.15,
          "neutral": 0.95,
          "bearish": 0.7
        },
        "regime_weights": {
          "weak": 0.7,
          "moderate": 1.0,
          "strong": 1.25
        },
        "momentum_component_weights": {
          "price_to_fast_ema": 0.35,
          "ema_gap": 0.25,
          "vwap_distance": 0.2,
          "macd_hist": 0.1,
          "atr_rising": 0.1
        },
        "momentum_scales": {
          "price_to_fast_ema_ratio": 0.006,
          "ema_gap_ratio": 0.004,
          "vwap_distance_ratio": 0.004,
          "macd_hist_atr_ratio": 0.25
        }
      }
    },
    "daily_controls": {
      "enabled": true,
      "target_daily_return": 0.003,
      "max_daily_loss": -0.01,
      "max_daily_risk": 0.05,
      "loss_brake_multiplier": 0.7,
      "target_brake_multiplier": 0.5,
      "soft_trade_cap": 20,
      "max_trades_per_day": 40,
      "soft_cap_min_strength": 0.55
    },
    "exploration": {
      "enabled": false,
      "enabled_sides": ["long", "short"],
      "allow_neutral_bias": true,
      "block_opposite_bias": true,
      "require_atr_rising": true,
      "require_vwap_alignment": false,
      "require_macd_alignment": false,
      "minimum_regime_score": 2,
      "allowed_regime_classes": ["moderate", "strong"],
      "pressure_score_threshold": 4,
      "pressure_score_threshold_by_side": {
        "short": 4
      },
      "entry_risk_multiplier": 0.25,
      "entry_risk_multiplier_by_side": {
        "short": 0.20
      },
      "entry_priority": 0,
      "entry_role": "support"
    },
    "bias": {
      "ema_column": "ema50",
      "slope_lookback": 3,
      "slope_threshold": 0.0005
    },
    "pyramiding": {
      "max_total_risk_multiple": 1.0,
      "quality_gate": {
        "enabled": true,
        "body_strength_min": 1.5,
        "upper_wick_max": 0.6,
        "lower_wick_max": 0.6,
        "close_position_min": 0.75,
        "min_confirmations": 2,
        "min_open_r_multiple": 1.0,
        "max_total_risk_multiple": 2.5,
        "size_fraction_multipliers_by_level": {
          "2": 1.5
        }
      },
      "levels": [
        {
          "level": 1,
          "r_multiple": 1,
          "size_fraction": 0.5
        },
        {
          "level": 2,
          "r_multiple": 2,
          "size_fraction": 0.5
        }
      ]
    },
    "regime": {
      "ema_column": "ema50",
      "macro_weight": 2,
      "macro_slope_weight": 1,
      "trend_weight": 1,
      "slope_lookback": 5,
      "slope_threshold": 0.0005,
      "strong_score": 3,
      "moderate_score": 2
    },
    "scoring": {
      "bias_weight": 2,
      "trend_weight": 1,
      "compression_weight": 1,
      "breakout_weight": 2,
      "breakdown_weight": 2,
      "body_strength_weight": 1,
      "close_position_weight": 1,
      "upper_wick_weight": 1,
      "lower_wick_weight": 1,
      "vwap_weight": 1,
      "atr_weight": 1,
      "macd_weight": 1,
      "bollinger_weight": 1,
      "body_strength_min": 1.3,
      "close_position_min": 0.6,
      "close_position_max": 0.4,
      "upper_wick_max": 1,
      "lower_wick_max": 1
    },
    "sniffing": {
      "body_strength_min": 0.8,
      "close_position_min": 0.4,
      "close_position_max": 0.6,
      "upper_wick_max": 1.5,
      "lower_wick_max": 1.5,
      "min_confirmations": 1,
      "relax_after_r": 1.0,
      "relaxed_min_confirmations": 0,
      "slow_anchor_after_r": 1.5,
      "require_short_vwap_alignment": true,
      "trailing": {
        "strong_body_min": 1.0,
        "clean_wick_max": 1.0,
        "min_vwap_distance": 0.0,
        "min_ema_gap": 0.0,
        "vwap_decay_threshold": 0.0015,
        "ema_gap_decay_threshold": 0.0010,
        "macd_decay_threshold": 0.0,
        "body_decay_max": 0.8,
        "wick_decay_min": 1.5,
        "decay_close_position_max": 0.45,
        "strong_close_position_min": 0.65,
        "init_max_r": 0.5,
        "confirmation_max_r": 1.5,
        "expansion_min_momentum_signals": 4,
        "decay_signal_threshold": 2,
        "force_exit_decay_signal_threshold": 4,
        "init_atr_buffer": 1.2,
        "confirmation_atr_buffer": 0.9,
        "expansion_atr_buffer": 1.8,
        "decay_atr_buffer": 0.35,
        "exit_atr_buffer": 0.15,
        "expansion_anchor": "slow_ema",
        "decay_anchor": "fast_ema",
        "confirmation_anchor": "fast_ema",
        "by_side": {
          "short": {
            "strong_close_position_max": 0.35,
            "decay_close_position_min": 0.55,
            "init_max_r": 0.35,
            "confirmation_max_r": 1.0,
            "expansion_min_momentum_signals": 3,
            "force_exit_decay_signal_threshold": 3,
            "init_atr_buffer": 1.0,
            "confirmation_atr_buffer": 0.7,
            "expansion_atr_buffer": 1.0,
            "decay_atr_buffer": 0.25,
            "exit_atr_buffer": 0.10,
            "expansion_anchor": "fast_ema",
            "decay_anchor": "fast_ema"
          }
        }
      }
    }
  },
  "timeframes": {
    "base": {
      "label": "1m",
      "rule": "1min"
    },
    "execution": {
      "label": "15m",
      "rule": "15min"
    },
    "direction": {
      "label": "1h",
      "rule": "1h"
    },
    "trend": {
      "label": "5h",
      "rule": "5h"
    },
    "macro": {
      "label": "12h",
      "rule": "12h"
    },
    "resample": {
      "closed": "left",
      "label": "right",
      "drop_incomplete": true
    }
  }
}
