{
  "app": {
    "default_symbol": "BTCUSDT",
    "debug": true
  },
  "account": {
    "initial_equity": 20000,
    "risk_per_trade": 0.01
  },
  "backtest": {
    "output_dir": "backtest/output",
    "checkpoint_dir": "_checkpoints",
    "checkpoint_suffix": ".checkpoint.json",
    "resume_enabled": true,
    "save_every_steps": 250
  },
  "binance": {
    "base_url": "https://api.binance.com",
    "klines_path": "/api/v3/klines",
    "default_interval": "1m",
    "historical_limit": 1000,
    "recent_limit": 1000,
    "request_timeout_seconds": 20,
    "retry_attempts": 3,
    "retry_backoff_seconds": 1,
    "retry_status_codes": [418, 429, 500, 502, 503, 504],
    "retry_logging_enabled": true,
    "ssl_verify": false,
    "ca_bundle_path": null,
    "closed_klines_only": true,
    "throttle_seconds": 0.2
  },
  "downloads": {
    "history": {
      "checkpoint_dir": "_checkpoints",
      "checkpoint_suffix": ".checkpoint.json",
      "partial_suffix": ".partial.csv",
      "resume_enabled": true,
      "save_every_batches": 1,
      "status_every_batches": 1,
      "cleanup_partial_on_complete": true
    }
  },
  "entry": {
    "score_threshold": 4,
    "block_compression": true,
    "blocked_scores": [7]
  },
  "features": {
    "ema_periods": {
      "fast": 20,
      "slow": 50
    },
    "structure": {
      "high_period": 20,
      "low_period": 10
    },
    "compression": {
      "fast_range_period": 10,
      "slow_range_period": 30,
      "ratio": 0.7
    },
    "candle_metrics": {
      "average_body_period": 10
    }
  },
  "history": {
    "start_date": "2018-01-01",
    "end_date": "2026-05-12"
  },
  "live_sim": {
    "output_dir": "live_sim/output",
    "poll_seconds": 30
  },
  "position": {
    "min_stop_distance_ratio": 0.001,
    "min_stop_distance_absolute": 0.0,
    "max_position_size_units": null,
    "max_notional_equity_multiple": null
  },
  "storage": {
    "base_path": "data_storage"
  },
  "strategy": {
    "bias": {
      "ema_column": "ema50",
      "slope_lookback": 3,
      "slope_threshold": 0.0005
    },
    "pyramiding": {
      "max_total_risk_multiple": 1.0,
      "levels": [
        {
          "level": 1,
          "r_multiple": 1,
          "size_fraction": 0.5
        },
        {
          "level": 2,
          "r_multiple": 2,
          "size_fraction": 0.5
        }
      ]
    },
    "regime": {
      "ema_column": "ema50",
      "macro_weight": 2,
      "macro_slope_weight": 1,
      "trend_weight": 1,
      "slope_lookback": 5,
      "slope_threshold": 0.0005,
      "strong_score": 3,
      "moderate_score": 2
    },
    "scoring": {
      "bias_weight": 2,
      "trend_weight": 1,
      "compression_weight": 1,
      "breakout_weight": 2,
      "body_strength_weight": 1,
      "close_position_weight": 1,
      "upper_wick_weight": 1,
      "body_strength_min": 1.3,
      "close_position_min": 0.6,
      "upper_wick_max": 1
    },
    "sniffing": {
      "body_strength_min": 0.8,
      "close_position_min": 0.4,
      "upper_wick_max": 1.5,
      "min_confirmations": 1
    }
  },
  "timeframes": {
    "base": {
      "label": "1m",
      "rule": "1min"
    },
    "execution": {
      "label": "15m",
      "rule": "15min"
    },
    "direction": {
      "label": "1h",
      "rule": "1h"
    },
    "trend": {
      "label": "5h",
      "rule": "5h"
    },
    "macro": {
      "label": "12h",
      "rule": "12h"
    },
    "resample": {
      "closed": "left",
      "label": "right",
      "drop_incomplete": true
    }
  }
}
