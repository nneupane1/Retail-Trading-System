{
  "name": "structural_compounding_lab",
  "version": "0.1.0",
  "research_only": true,
  "read_only_frontend": true,
  "separate_from_runtime": true,
  "primary_routes": [
    "/structural-lab",
    "/structural-lab/overview",
    "/structural-lab/market-replay",
    "/structural-lab/structure-map",
    "/structural-lab/profit-vault",
    "/structural-lab/trade-review",
    "/structural-lab/settings"
  ],
  "entrypoints": {
    "cockpit_launcher": "run_structural_compounding_cockpit.py",
    "backtest_cli": "python -m structural_compounding_lab.backtest.run_structural_backtest"
