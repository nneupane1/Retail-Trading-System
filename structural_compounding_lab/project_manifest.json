    "summary.json",
    "equity.csv",
    "trades.csv",
    "setup_log.csv",
    "level_log.csv",
    "liquidity_events.csv",
    "profit_vault.json",
    "cooldown_log.csv",
    "pyramiding_log.csv",
    "report.md",
    "diagnostics/pullback_quality_report.json",
    "diagnostics/original_vs_pullback_entry.csv",
    "diagnostics/pullback_type_performance_report.json",
    "diagnostics/missed_due_to_waiting_report.csv",
    "diagnostics/pullback_compounding_readiness_report.json",
    "diagnostics/personality_performance_report.json",
    "diagnostics/indicator_confluence_report.json",
    "execution_realism/execution_cost_sensitivity.json"
